{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true
  },
  "files": [
    "./main.ts",
    "./preview.ts"
  ],
  "include": [
    "../src/**/*.stories.ts",
    "../src/**/*.stories.tsx",
    "./**/*.ts"
  ],
  "exclude": [
    "../src/test.ts",
    "../src/**/*.spec.ts"
  ]
}
